# Banco. Em dev, `npm run db` sobe um Postgres embutido (PGlite) nesta porta.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable"
# Só para o PGlite de dev: serializa as conexões. Em Postgres real, remova.
DATABASE_POOL_MAX="1"

# URL pública do app (usada em links do pedido e no callback da Asaas).
APP_URL="http://localhost:3000"

# Segredos: gere com `openssl rand -base64 32`.
SESSION_SECRET=""
# 32 bytes em base64. Criptografa o token da Conversions API no banco.
ENCRYPTION_KEY=""
# Assina o payload do QR Code do ingresso (HMAC).
TICKET_HMAC_SECRET=""
# Protege a rota /api/cron/expire-holds.
CRON_SECRET=""

# Asaas. Sem ASAAS_API_KEY o app roda em modo simulado (sem cobrança real).
ASAAS_API_KEY=""
ASAAS_ENV="sandbox" # sandbox | production
# Token configurado no painel da Asaas para o webhook (header asaas-access-token).
ASAAS_WEBHOOK_TOKEN=""

# Links únicos da operação (LGPD).
TERMS_URL="https://example.com/termos"
PRIVACY_URL="https://example.com/privacidade"

# Admin criado pelo seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
