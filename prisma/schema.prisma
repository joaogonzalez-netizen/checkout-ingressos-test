// Modelo de dados do checkout de ingressos.
// Fonte: aba "PRD — Backoffice de Eventos" (Modelo de dados) + "Arquitetura MVP".
// Valores monetários sempre em centavos (Int). Datas sempre em UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  producer
  supervisor
  operator
}

enum EventStatus {
  draft
  published
  closed
}

enum SeatingMode {
  seated
  general
}

enum LotCategory {
  inteira
  meia
  solidario
  promocional
  cortesia
}

enum SeatStatus {
  available
  blocked
  held
  sold
}

enum OrderStatus {
  pending
  paid
  failed
  expired
  canceled
  refunded
}

enum PaymentMethod {
  credit_card
  pix
}

enum TicketStatus {
  valid
  used
  canceled
}

enum ValidationMethod {
  qr
  code
  manual
  list
}

enum MediaKind {
  video_9x16
  // Vídeo da VSL em qualquer orientação (9:16 em pé ou 16:9 deitado); width/height dizem qual.
  video
  cover
  // Variante 4:5 do header para celular (opcional).
  cover_mobile
  gallery
  og_image
  thumbnail
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String     @map("password_hash")
  // v1: só o perfil admin é usado; os demais já existem para BO-01.
  role               Role       @default(admin)
  // Desativado não entra e perde as sessões abertas.
  active             Boolean    @default(true)
  // Senha definida por outra pessoa (temporária): obriga a troca no primeiro acesso.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  // Vai no token de sessão; incrementar derruba todas as sessões do usuário.
  sessionVersion     Int        @default(0) @map("session_version")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  passwordChangedAt  DateTime?  @map("password_changed_at")
  createdById        String?    @map("created_by_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  auditLogs          AuditLog[]

  @@map("users")
}

model Artist {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  logoUrl               String?   @map("logo_url")
  logoKey               String?   @map("logo_key")
  // { primary, secondary, accent, background } em hex
  colors                Json
  backLinkUrl           String?   @map("back_link_url")
  metaPixelId           String?   @map("meta_pixel_id")
  // Criptografado com AES-256-GCM (ENCRYPTION_KEY). Nunca volta para o browser.
  metaCapiTokenEnc      String?   @map("meta_capi_token")
  defaultShowName       String?   @map("default_show_name")
  defaultVslSubtitle    String?   @map("default_vsl_subtitle")
  defaultOgImageUrl     String?   @map("default_og_image_url")
  defaultOgImageKey     String?   @map("default_og_image_key")
  // Header padrão do site, herdado pelos eventos que não enviarem o próprio.
  defaultCoverUrl       String?   @map("default_cover_url")
  defaultCoverKey       String?   @map("default_cover_key")
  defaultCoverMobileUrl String?   @map("default_cover_mobile_url")
  defaultCoverMobileKey String?   @map("default_cover_mobile_key")
  // Desativado: some das listas e não recebe eventos novos. Eventos existentes continuam.
  archivedAt            DateTime? @map("archived_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  events                Event[]

  @@map("artists")
}

model Event {
  id                    String          @id @default(cuid())
  artistId              String          @map("artist_id")
  artist                Artist          @relation(fields: [artistId], references: [id])
  showName              String?         @map("show_name")
  city                  String?
  state                 String?
  venueName             String?         @map("venue_name")
  venueAddress          String?         @map("venue_address")
  startsAt              DateTime?       @map("starts_at")
  endsAt                DateTime?       @map("ends_at")
  doorsOpenAt           DateTime?       @map("doors_open_at")
  slug                  String?         @unique
  status                EventStatus     @default(draft)
  vslHeadline           String?         @map("vsl_headline")
  vslSubtitle           String?         @map("vsl_subtitle")
  vslCtaLabel           String?         @map("vsl_cta_label")
  // Descrição longa ("Descrição do evento") e regras de acesso ("Informações gerais").
  description           String?
  accessRules           String?         @map("access_rules")
  // Classificação indicativa: "L", "10", "12", "14", "16" ou "18"; nota opcional (ex.: menores com responsável).
  ageRating             String?         @map("age_rating")
  ageRatingNote         String?         @map("age_rating_note")
  ogImageUrl            String?         @map("og_image_url")
  ogImageKey            String?         @map("og_image_key")
  // Limite total de ingressos do evento: a soma das quantidades dos lotes não pode passar dele.
  ticketLimit           Int?            @map("ticket_limit")
  seatingMode           SeatingMode?    @map("seating_mode")
  seatRows              Int?            @map("seat_rows")
  seatsPerRow           Int?            @map("seats_per_row")
  metaPixelOverride     String?         @map("meta_pixel_override")
  metaCapiTokenOverride String?         @map("meta_capi_token_override")
  // Última etapa do wizard concluída (0–6), para retomar o rascunho.
  wizardStep            Int             @default(0) @map("wizard_step")
  publishedAt           DateTime?       @map("published_at")
  // Arquivado: sai da lista principal (aba "Arquivados"). Pedidos e ingressos continuam guardados.
  archivedAt            DateTime?       @map("archived_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  lots                  TicketLot[]
  seats                 Seat[]
  orders                Order[]
  tickets               Ticket[]
  media                 EventMedia[]
  checkinAccess         CheckinAccess[]

  @@map("events")
}

// BO-12/BO-13: header e vídeo da VSL enviados pelo backoffice (storage próprio).
model EventMedia {
  id              String    @id @default(cuid())
  eventId         String    @map("event_id")
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind            MediaKind
  // Chave no storage (ex.: events/<id>/cover-<rand>.webp); url = /media/<key>.
  storageKey      String?   @map("storage_key")
  url             String
  posterUrl       String?   @map("poster_url")
  posterKey       String?   @map("poster_key")
  mime            String?
  sizeBytes       Int?      @map("size_bytes")
  width           Int?
  height          Int?
  durationSeconds Float?    @map("duration_seconds")
  position        Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([eventId, kind])
  @@map("event_media")
}

model TicketLot {
  id           String      @id @default(cuid())
  eventId      String      @map("event_id")
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  // Quem tem direito / o que levar (ex.: "Doação de 1 L de leite na entrada").
  description  String?
  category     LotCategory
  priceCents   Int         @map("price_cents")
  quantity     Int
  // Pagos.
  sold         Int         @default(0)
  // Pagos + pendentes dentro da janela de reserva. Disponível = quantity - reserved.
  reserved     Int         @default(0)
  salesStartAt DateTime?   @map("sales_start_at")
  salesEndAt   DateTime?   @map("sales_end_at")
  position     Int         @default(0)
  orders       Order[]
  orderItems   OrderItem[]
  tickets      Ticket[]

  @@map("ticket_lots")
}

model Seat {
  id      String     @id @default(cuid())
  eventId String     @map("event_id")
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  row     String
  number  Int
  status  SeatStatus @default(available)
  // Pedido que segura (held) ou comprou (sold) a poltrona.
  orderId String?    @map("order_id")
  orders  Order[]
  tickets Ticket[]

  @@unique([eventId, row, number])
  @@map("seats")
}

model Order {
  id                 String        @id @default(cuid())
  // Token aleatório exigido para ver o pedido sem login (/pedido/[id]?t=...).
  accessToken        String        @map("access_token")
  eventId            String        @map("event_id")
  event              Event         @relation(fields: [eventId], references: [id])
  // Legado (pedidos de 1 ingresso). A fonte da verdade são os itens (OrderItem).
  lotId              String?       @map("lot_id")
  lot                TicketLot?    @relation(fields: [lotId], references: [id])
  seatId             String?       @map("seat_id")
  seat               Seat?         @relation(fields: [seatId], references: [id])
  status             OrderStatus   @default(pending)
  paymentMethod      PaymentMethod @map("payment_method")
  installments       Int           @default(1)
  buyerName          String        @map("buyer_name")
  buyerEmail         String        @map("buyer_email")
  buyerCpfCnpj       String        @map("buyer_cpf_cnpj")
  // Celular com DDD, só dígitos. Busca no check-in e entrega por WhatsApp (Fase 2). Nulo em pedidos antigos.
  buyerPhone         String?       @map("buyer_phone")
  ticketCents        Int           @map("ticket_cents")
  feeCents           Int           @map("fee_cents")
  totalCents         Int           @map("total_cents")
  asaasCustomerId    String?       @map("asaas_customer_id")
  // Id da cobrança na Asaas: conciliação com repasse/antecipação.
  asaasPaymentId     String?       @unique @map("asaas_payment_id")
  invoiceUrl         String?       @map("invoice_url")
  pixPayload         String?       @map("pix_payload")
  pixQrImage         String?       @map("pix_qr_image")
  holdExpiresAt      DateTime      @map("hold_expires_at")
  paidAt             DateTime?     @map("paid_at")
  acceptedTermsAt    DateTime      @map("accepted_terms_at")
  // Opt-in de marketing (LGPD): opcional, desmarcado por padrão.
  marketingOptIn     Boolean       @default(false) @map("marketing_opt_in")
  // Dados para a Conversions API (deduplicação e match).
  fbp                String?
  fbc                String?
  clientIp           String?       @map("client_ip")
  userAgent          String?       @map("user_agent")
  sourceUrl          String?       @map("source_url")
  capiPurchaseSentAt DateTime?     @map("capi_purchase_sent_at")
  lastReconciledAt   DateTime?     @map("last_reconciled_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  tickets            Ticket[]
  items              OrderItem[]

  @@index([eventId, status])
  @@index([status, holdExpiresAt])
  @@map("orders")
}

// Uma linha por lote no pedido (ex.: 2x Inteira + 1x Meia). Cada unidade vira um Ticket.
model OrderItem {
  id        String    @id @default(cuid())
  orderId   String    @map("order_id")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lotId     String    @map("lot_id")
  lot       TicketLot @relation(fields: [lotId], references: [id])
  quantity  Int
  unitCents Int       @map("unit_cents")
  // Taxa de serviço por unidade.
  feeCents  Int       @map("fee_cents")

  @@unique([orderId, lotId])
  @@map("order_items")
}

model Ticket {
  id               String            @id @default(cuid())
  eventId          String            @map("event_id")
  event            Event             @relation(fields: [eventId], references: [id])
  orderId          String            @map("order_id")
  order            Order             @relation(fields: [orderId], references: [id])
  lotId            String            @map("lot_id")
  lot              TicketLot         @relation(fields: [lotId], references: [id])
  seatId           String?           @map("seat_id")
  seat             Seat?             @relation(fields: [seatId], references: [id])
  // Código curto de fallback: 4 caracteres sem 0/O/1/I/L, único no evento.
  code             String
  // Payload do QR assinado com HMAC, verificável offline.
  qrPayload        String            @unique @map("qr_payload")
  status           TicketStatus      @default(valid)
  usedAt           DateTime?         @map("used_at")
  usedBy           String?           @map("used_by")
  validationMethod ValidationMethod? @map("validation_method")
  manualReason     String?           @map("manual_reason")
  createdAt        DateTime          @default(now()) @map("created_at")

  @@unique([eventId, code])
  @@map("tickets")
}

// Pronto para BO-10 (Fase 3).
/// Link de conferência da portaria: /conferencia/<token> + PIN de 6 números. Um link ativo por evento.
model CheckinAccess {
  id             String    @id @default(cuid())
  eventId        String    @map("event_id")
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Parte secreta do endereço do link.
  token          String    @unique
  pinHash        String    @map("pin_hash")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdBy      String    @map("created_by")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("checkin_access")
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String   @map("entity_id")
  action    String
  before    Json?
  after     Json?
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@index([entity, entityId])
  @@map("audit_log")
}

// Idempotência do webhook: o mesmo evento da Asaas pode chegar mais de uma vez.
model WebhookEvent {
  id          String    @id
  event       String
  paymentId   String?   @map("payment_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@map("webhook_events")
}

// Configurações da operação (uma linha só, id = "default"): dados de quem vende e textos legais
// exibidos em todas as páginas de venda.
model PlatformSettings {
  id               String   @id @default("default")
  sellerName       String?  @map("seller_name")
  sellerCnpj       String?  @map("seller_cnpj")
  sellerAddress    String?  @map("seller_address")
  contactEmail     String?  @map("contact_email")
  contactWhatsapp  String?  @map("contact_whatsapp")
  halfPriceText    String?  @map("half_price_text")
  cancellationText String?  @map("cancellation_text")
  feeText          String?  @map("fee_text")
  // Evento aberto no endereço principal do site (/). Vazio = / vai para o backoffice.
  homeEventSlug    String?  @map("home_event_slug")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

// Cobranças do modo simulado (dev e DEMO_MODE). Ficam no banco porque, na Vercel, a memória do
// servidor não sobrevive entre requisições.
model MockPayment {
  id                String   @id
  status            String   @default("PENDING")
  value             Float
  billingType       String   @map("billing_type")
  externalReference String?  @map("external_reference")
  deleted           Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("mock_payments")
}
