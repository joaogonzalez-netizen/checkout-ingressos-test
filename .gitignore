# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# banco local (PGlite)
/.pglite

# prisma client gerado
/src/generated

# uploads locais (storage de dev)
/.uploads

# configuração local de ferramentas (preview)
/.claude

# credenciais de produção guardadas localmente
/.producao-*.txt

# arquivos da integração Neon para agentes (fora do escopo do projeto)
/.agents
/skills-lock.json
